<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Technical Revision Request System</title>
	@*<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />*@
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<script src="~/css/tailwind.min.css"></script>
	<link rel="stylesheet" href="~/font-icons/font-awesome/css/all.css" />
	<link rel="stylesheet" href="~/TechnicalRevisionRequestSystem.styles.css" asp-append-version="true" />




</head>
<body class="bg-slate-100">

	<div class="flex h-screen overflow-hidden">

		<!-- SIDEBAR -->
		<aside id="sidebar" class="w-64 transition-all duration-300 bg-white/40 backdrop-blur-xl border-r border-white/30 shadow-lg flex flex-col">

			<!-- Logo -->
			<div class="flex items-center gap-3">
				<img src="~/images/trrf_logo.png"
					 class="w-50 h-500 object-contain"
					 alt="TRRS Logo" />

				
			</div>

			<!-- Menu -->
			<nav class="flex-1 overflow-y-auto p-4 space-y-4">

				<!-- MENU GROUP -->
				<div>
					<p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
						Main Menu
					</p>

					<div class="space-y-1">

						<a href="/TRRF/Index"
						   class="flex items-center gap-2 px-3 py-2 rounded-lg text-slate-700 hover:bg-white/60 hover:shadow transition">

							<i class="fa fa-table-list"></i> <span class="menu-text">&nbsp;TRRF Tracking</span>

						</a>

				

					</div>
				</div>

				<!-- MENU GROUP 2 -->
				@*<div>
					<p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
						Requests
					</p>

					<div class="space-y-1">

						<a href="/Request/Create"
						    class="flex items-center gap-2 px-3 py-2 rounded-lg text-slate-700 hover:bg-white/60 hover:shadow transition">
							<span class="menu-text">Create Request</span>
						</a>

						<a href="/Request/List"
						    class="flex items-center gap-2 px-3 py-2 rounded-lg text-slate-700 hover:bg-white/60 hover:shadow transition">
							<span class="menu-text">Request List</span>
						</a>

					</div>
				</div>*@

			</nav>

			<!-- Footer -->
			<div class="p-4 text-xs text-slate-500 border-t border-white/20">
				v1.0.0
			</div>
		</aside>

		<!-- MAIN AREA -->
		<div class="flex-1 flex flex-col min-w-0">

			<!-- TOP NAV -->
			<!-- TOP NAV -->
			<header class="h-16 bg-white/40 backdrop-blur-xl border-b border-white/30 shadow-sm flex items-center justify-between px-6">

				<div class="flex items-center gap-3">

					<!-- SIDEBAR TOGGLE BUTTON -->
					<button id="sidebarToggle"
							class="p-2 rounded-lg hover:bg-white/60 transition">

						<!-- 3-line icon -->
						<div class="space-y-1">
							<div class="w-5 h-0.5 bg-slate-700"></div>
							<div class="w-5 h-0.5 bg-slate-700"></div>
							<div class="w-5 h-0.5 bg-slate-700"></div>
						</div>

					</button>

					<span class="text-slate-700 font-semibold">TRRS</span>

				</div>

				<div class="flex items-center gap-4">
					<div class="w-9 h-9 rounded-full bg-slate-300"></div>
				</div>

			</header>

			<!-- PAGE CONTENT -->
			<main class="flex-1 overflow-auto p-6 min-w-0">
				@RenderBody()
			</main>

		</div>

	</div>

	<script src="~/js/site.js" asp-append-version="true"></script>


	@await RenderSectionAsync("Scripts", required: false)
	<script>
		document.addEventListener( "DOMContentLoaded", function ()
		{

			const sidebar = document.getElementById( "sidebar" );
			const toggle = document.getElementById( "sidebarToggle" );

			if ( !sidebar || !toggle ) return;

			let collapsed = false;

			toggle.addEventListener( "click", function ()
			{
				collapsed = !collapsed;

				if ( collapsed )
				{
					sidebar.classList.remove( "w-64" );
					sidebar.classList.add( "w-20" );

					document.querySelectorAll( ".menu-text" ).forEach( el =>
					{
						el.style.display = "none";
					} );
				} else
				{
					sidebar.classList.remove( "w-20" );
					sidebar.classList.add( "w-64" );

					document.querySelectorAll( ".menu-text" ).forEach( el =>
					{
						el.style.display = "inline";
					} );
				}

				setTimeout( function ()
				{
					if ( window.mainTable )
					{
						window.mainTable.redraw( true );
					}
				}, 350 );
			} );

		} );
	</script>
</body>



</html>
