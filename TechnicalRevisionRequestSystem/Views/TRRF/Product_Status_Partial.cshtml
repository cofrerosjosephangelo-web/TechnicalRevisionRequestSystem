
<div class="glass-card p-6">

	<div class="flex items-center gap-2 pb-3 mb-4 border-b border-white/40">
		<i class="fa-solid fa-tag text-slate-600"></i>
		<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
			Product Status
		</h3>
	</div>

	<div class="space-y-5">

		<!-- Rush -->
		<div class="flex items-center justify-between">
			<label class="text-sm font-semibold text-slate-700">
				Rush
			</label>

			<label class="relative inline-flex items-center cursor-pointer">
				<input type="checkbox" id="isRush" class="sr-only peer">

				<div class="w-11 h-6 bg-slate-300 rounded-full
                        peer peer-checked:bg-blue-600
                        after:content-['']
                        after:absolute after:top-[2px] after:left-[2px]
                        after:bg-white after:border after:border-slate-300
                        after:rounded-full after:h-5 after:w-5
                        after:transition-all
                        peer-checked:after:translate-x-full">
				</div>
			</label>
		</div>

		<!-- Next Production -->
		<div class="flex items-center justify-between">
			<label class="text-sm font-semibold text-slate-700">
				Next Production
			</label>

			<label class="relative inline-flex items-center cursor-pointer">
				<input type="checkbox" id="isNextProduction" class="sr-only peer">

				<div class="w-11 h-6 bg-slate-300 rounded-full
                        peer peer-checked:bg-blue-600
                        after:content-['']
                        after:absolute after:top-[2px] after:left-[2px]
                        after:bg-white after:border after:border-slate-300
                        after:rounded-full after:h-5 after:w-5
                        after:transition-all
                        peer-checked:after:translate-x-full">
				</div>
			</label>
		</div>

		<!-- Status As Of -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Status As Of
			</label>

			<input type="date"
				   id="statusAsOf"
				   class="w-full rounded-xl border border-slate-200 bg-white/70
                      px-4 py-2.5 text-slate-700
                      focus:outline-none focus:ring-2 focus:ring-blue-400">
		</div>

		<!-- Required Date -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Required Date
			</label>

			<input type="date"
				   id="requiredDate"
				   class="w-full rounded-xl border border-slate-200 bg-white/70
                      px-4 py-2.5 text-slate-700
                      focus:outline-none focus:ring-2 focus:ring-blue-400">
		</div>

		<!-- Status Details -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Status Details
			</label>

			<textarea id="statusDetails"
					  rows="5"
					  class="w-full rounded-xl border border-slate-200 bg-white/70
                         px-4 py-3 text-slate-700 resize-none
                         focus:outline-none focus:ring-2 focus:ring-blue-400"></textarea>
		</div>

	</div>

</div>


