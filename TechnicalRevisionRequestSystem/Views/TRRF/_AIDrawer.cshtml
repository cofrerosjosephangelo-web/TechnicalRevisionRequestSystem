<!-- Ask Me Drawer -->
<div id="askMeDrawer"
	 class="fixed top-0 right-0 h-full w-[500px]
            bg-white/90 backdrop-blur-xl
            shadow-2xl border-l border-white/40
            transform translate-x-full
            transition-transform duration-300 ease-in-out
            z-50">

	<!-- Drawer Header -->
	<div class="flex items-center justify-between
                px-5 py-4
                border-b border-slate-200/70">

		<div class="flex items-center gap-3">

			<div class="flex items-center justify-center
                        w-10 h-10 rounded-xl
                        bg-blue-600 text-white shadow-sm">

				<i class="fa-solid fa-robot text-lg"></i>

			</div>

			<div>
				<h2 class="text-base font-semibold text-slate-800">
					Ask Me
				</h2>

				<p class="text-xs text-slate-500">
					TRRS AI Assistant
				</p>
			</div>

		</div>

		<button type="button"
				id="closeAskMeDrawer"
				class="w-8 h-8 rounded-lg
                       flex items-center justify-center
                       text-slate-500
                       hover:bg-slate-200
                       hover:text-slate-700
                       transition">

			<i class="fa-solid fa-xmark"></i>

		</button>

	</div>


	<!-- ====================================================== -->
	<!-- WELCOME SCREEN -->
	<!-- ====================================================== -->

	<div id="askMeWelcome"
		 class="flex flex-col items-center justify-center
                text-center
                px-8
                h-[calc(100%-73px)]">

		<div class="flex items-center justify-center
                    w-20 h-20
                    rounded-2xl
                    bg-blue-600
                    text-white
                    shadow-lg
                    mb-5">

			<i class="fa-solid fa-robot text-4xl"></i>

		</div>

		<h3 class="text-xl font-semibold text-slate-800 mb-2">
			Welcome to TRRS AI
		</h3>

		<p class="text-sm text-slate-500 leading-relaxed max-w-sm mb-6">
			Ask questions about TRRS history, problems, root causes,
			action plans, mold life, revisions, and historical patterns.
		</p>

		<button type="button"
				id="btnLetsStart"
				class="inline-flex items-center gap-2
                       px-5 py-2.5
                       rounded-lg
                       bg-blue-600
                       text-white
                       text-sm font-medium
                       shadow-sm
                       hover:bg-blue-700
                       transition">

			<i class="fa-solid fa-play"></i>

			<span>Let's Start!</span>

		</button>

	</div>


	<!-- ====================================================== -->
	<!-- AI CHAT SCREEN -->
	<!-- ====================================================== -->

	<div id="askMeChat"
		 class="hidden flex-col h-[calc(100%-73px)]">

		<!-- AI Answer Area -->
		<div id="aiChatMessages"
			 class="flex-1 overflow-y-auto
            px-5 py-5
            space-y-4">

			<!-- Initial AI message -->
			<div class="flex justify-start">

				<div class="max-w-[85%]
                    rounded-2xl
                    bg-[#e6e6e6]
                    px-4 py-3">

					<p class="text-sm text-slate-700">
						Hello! I'm ready to help you analyze the
						TRRS historical records. What would you like
						to know?
					</p>

				</div>

			</div>

		</div>


		<!-- Question Input -->
		<div class="border-t border-slate-200/70
                    bg-white/60
                    p-4">

			<div class="relative">

				<textarea id="aiQuestion"
						  rows="3"
						  placeholder="Ask your TRRS question..."
						  class="w-full resize-none
                                 rounded-xl
                                 border border-slate-300
                                 bg-white
                                 px-4 py-3
                                 pr-12
                                 text-sm
                                 text-slate-700
                                 placeholder:text-slate-400
                                 focus:outline-none
                                 focus:ring-2
                                 focus:ring-blue-500/30
                                 focus:border-blue-500"></textarea>

			</div>

			<div class="flex items-center justify-between mt-2">

				<span class="text-xs text-slate-400">
					Ask about TRRS history and patterns
				</span>

				<button type="button"
						id="btnSendAI"
						class="inline-flex items-center gap-2
                               px-4 py-2
                               rounded-lg
                               bg-blue-600
                               text-white
                               text-sm font-medium
                               hover:bg-blue-700
                               transition">

					<i class="fa-solid fa-paper-plane"></i>

					<span>Send</span>

				</button>

			</div>

		</div>

	</div>

</div>


<!-- Drawer Backdrop -->
<div id="askMeBackdrop"
	 class="fixed inset-0
            bg-black/20 backdrop-blur-[2px]
            hidden
            z-40">
</div>


<script>
	//const askMeDrawer = document.getElementById( "askMeDrawer" );
	//const askMeBackdrop = document.getElementById( "askMeBackdrop" );

	//const askMeWelcome = document.getElementById( "askMeWelcome" );
	//const askMeChat = document.getElementById( "askMeChat" );

	//const btnLetsStart = document.getElementById( "btnLetsStart" );
	//const closeAskMeDrawer = document.getElementById( "closeAskMeDrawer" );

	const aiChatMessages = document.getElementById( "aiChatMessages" );
	const aiQuestion = document.getElementById( "aiQuestion" );
	const btnSendAI = document.getElementById( "btnSendAI" );


	// ============================================================
	// OPEN DRAWER
	// ============================================================

	document.getElementById( "btnAskMe" ).addEventListener( "click", function ()
	{
		askMeDrawer.classList.remove( "translate-x-full" );
		askMeBackdrop.classList.remove( "hidden" );
	} );


	// ============================================================
	// CLOSE DRAWER
	// ============================================================

	function closeAskMe ()
	{
		askMeDrawer.classList.add( "translate-x-full" );
		askMeBackdrop.classList.add( "hidden" );
	}

	closeAskMeDrawer.addEventListener( "click", closeAskMe );

	askMeBackdrop.addEventListener( "click", closeAskMe );


	// ============================================================
	// LET'S START
	// ============================================================

	btnLetsStart.addEventListener( "click", function ()
	{
		askMeWelcome.classList.add( "hidden" );

		askMeChat.classList.remove( "hidden" );
		askMeChat.classList.add( "flex" );

		aiQuestion.focus();
	} );


	// ============================================================
	// ADD USER MESSAGE
	// ============================================================

	function addUserMessage ( message )
	{
		const wrapper = document.createElement( "div" );

		wrapper.className = "flex justify-end";

		const bubble = document.createElement( "div" );

		bubble.className =
			"max-w-[85%] rounded-2xl px-4 py-3 text-sm text-slate-800";

		bubble.style.backgroundColor = "#99ccff";

		bubble.textContent = message;

		wrapper.appendChild( bubble );

		aiChatMessages.appendChild( wrapper );

		scrollChatToBottom();
	}


	// ============================================================
	// ADD AI MESSAGE
	// ============================================================

	function addAIMessage ( message )
	{
		const wrapper = document.createElement( "div" );

		wrapper.className = "flex justify-start";

		const bubble = document.createElement( "div" );

		bubble.className =
			"max-w-[85%] rounded-2xl px-4 py-3 text-sm text-slate-700";

		bubble.style.backgroundColor = "#e6e6e6";

		bubble.textContent = message;

		wrapper.appendChild( bubble );

		aiChatMessages.appendChild( wrapper );

		scrollChatToBottom();

		return bubble;
	}


	// ============================================================
	// SCROLL CHAT
	// ============================================================

	function scrollChatToBottom ()
	{
		aiChatMessages.scrollTop =
			aiChatMessages.scrollHeight;
	}


	// ============================================================
	// SEND QUESTION
	// ============================================================

	async function sendAIQuestion ()
	{
		const question = aiQuestion.value.trim();

		if ( !question )
			return;


		// --------------------------------------------------------
		// SHOW USER QUESTION
		// --------------------------------------------------------

		addUserMessage( question );

		aiQuestion.value = "";


		// --------------------------------------------------------
		// SHOW AI THINKING
		// --------------------------------------------------------

		const thinkingBubble = addAIMessage(
			"TRRS AI Assistant is checking the records . . . ."
		);


		// --------------------------------------------------------
		// DISABLE SEND
		// --------------------------------------------------------

		btnSendAI.disabled = true;

		btnSendAI.classList.add(
			"opacity-50",
			"cursor-not-allowed"
		);


		try
		{
			// ----------------------------------------------------
			// CALL YOUR EXISTING AI CONTROLLER
			// ----------------------------------------------------

			const response = await fetch(
				"/KnowledgeAssistant/AskKnowledge",
				{
					method: "POST",

					headers:
					{
						"Content-Type": "application/json"
					},

					body: JSON.stringify(
						{
							question: question
						} )
				}
			);


			// ----------------------------------------------------
			// CHECK HTTP RESPONSE
			// ----------------------------------------------------

			if ( !response.ok )
			{
				let errorMessage = `HTTP ${ response.status }`;

				try
				{
					const errorData = await response.json();

					if ( errorData.error )
					{
						errorMessage += ` - ${ errorData.error }`;
					}
				}
				catch
				{
					// Ignore JSON parsing error
				}

				throw new Error( errorMessage );
			}


			const data = await response.json();


			// ----------------------------------------------------
			// REPLACE THINKING MESSAGE
			// ----------------------------------------------------

			thinkingBubble.textContent =
				data.answer ??
				"I couldn't find an answer in the TRRS history.";


			scrollChatToBottom();
		}
		catch ( error )
		{
			console.error(
				"TRRS AI Error:",
				error
			);

			thinkingBubble.textContent =
				"TRRS AI Error: " + error.message;
		}
		finally
		{
			// ----------------------------------------------------
			// ENABLE SEND
			// ----------------------------------------------------

			btnSendAI.disabled = false;

			btnSendAI.classList.remove(
				"opacity-50",
				"cursor-not-allowed"
			);

			aiQuestion.focus();

			scrollChatToBottom();
		}
	}


	// ============================================================
	// SEND BUTTON
	// ============================================================

	btnSendAI.addEventListener(
		"click",
		sendAIQuestion
	);


	// ============================================================
	// ENTER TO SEND
	// SHIFT + ENTER = NEW LINE
	// ============================================================

	aiQuestion.addEventListener(
		"keydown",
		function ( event )
		{
			if (
				event.key === "Enter" &&
				!event.shiftKey
			)
			{
				event.preventDefault();

				sendAIQuestion();
			}
		}
	);
</script>