	function setProductValue ()
	{

		const typedProduct = productNameInput.value.trim();

		// Empty input
		if ( !typedProduct )
		{
			productIdTxt.value = "";
			partModelNoTxt.value = "";
			return;
		}

		// Match "Product Name - Model"
		const selectedProduct = productList.find( product =>
			(
				product.productName +
				( product.modelpartno ? " - " + product.modelpartno : "" )
			).toLowerCase() === typedProduct.toLowerCase()
		);

		// Existing product selected
		if ( selectedProduct )
		{

			productIdTxt.value = selectedProduct.productId;
			partModelNoTxt.value = selectedProduct.modelpartno ?? "";

			// Optional
			console.log( selectedProduct.gml );

			return;
		}

		// New product entered
		const largestProductId = productList.length > 0
			? Math.max( ...productList.map( product => Number( product.productId ) || 0 ) )
			: 0;

		productIdTxt.value = largestProductId + 1;
		partModelNoTxt.value = "";
	}

productNameInput.addEventListener( "input", setProductValue );
productNameInput.addEventListener( "blur", setProductValue );


const trrfNoInput = document.getElementById( "trrfNoTxt" );

async function loadControl ()
{
	trrfNoInput.value = "Loading...";

	try
	{
		const response = await fetch( "@Url.Action("GetTrrsControl", "TRRF")" );

		if ( !response.ok )
		{
			throw new Error( "Failed to load TRRS control" );
		}

		const controls = await response.json();

		if ( controls.length > 0 )
		{
			trrfNoInput.value = controls[ 0 ].controlDisplay;
		} else
		{
			trrfNoInput.value = "";
		}
	} catch ( error )
	{
		console.error( error );
		trrfNoInput.value = "";
	}
}


async function loadCustomers ()
{
	customerSelect.innerHTML = `<option value="">Loading customers...</option>`;

	try
	{
		const response = await fetch( "/TRRF/GetCustomerLookup" );

		if ( !response.ok )
		{
			throw new Error( "Failed to load customers" );
		}

		const customers = await response.json();

		customerSelect.innerHTML = `<option value="">Select customer</option>`;

		customers.forEach( customer =>
		{
			const option = document.createElement( "option" );
			option.value = customer.customerId;
			option.textContent = customer.customerName;
			customerSelect.appendChild( option );
		} );
	} catch ( error )
	{
		console.error( error );
		customerSelect.innerHTML = `<option value="">Unable to load customers</option>`;
	}
	}



	document.addEventListener( "DOMContentLoaded", function ()
	{

		const yearSelect = document.getElementById( "dashboardYear" );
		const startYear = 2025;
		const currentYear = new Date().getFullYear();

		yearSelect.innerHTML = "";

		// Show newest year first
		for ( let year = currentYear; year >= startYear; year-- )
		{
			const option = document.createElement( "option" );
			option.value = year;
			option.textContent = year;

			if ( year === currentYear )
			{
				option.selected = true;
			}

			yearSelect.appendChild( option );
		}

	} );


	const btnAskMe = document.getElementById( "btnAskMe" );
	const askMeDrawer = document.getElementById( "askMeDrawer" );
	const askMeBackdrop = document.getElementById( "askMeBackdrop" );

	const closeAskMeDrawer = document.getElementById( "closeAskMeDrawer" );

	const btnLetsStart = document.getElementById( "btnLetsStart" );
	const askMeWelcome = document.getElementById( "askMeWelcome" );
	const askMeChat = document.getElementById( "askMeChat" );


	// ============================================================
	// OPEN ASK ME
	// ============================================================

	btnAskMe.addEventListener( "click", function ()
	{

		askMeDrawer.classList.remove( "translate-x-full" );
		askMeBackdrop.classList.remove( "hidden" );

	} );


	// ============================================================
	// CLOSE ASK ME
	// ============================================================

	function closeAskMe ()
	{

		askMeDrawer.classList.add( "translate-x-full" );
		askMeBackdrop.classList.add( "hidden" );

	}

	closeAskMeDrawer.addEventListener( "click", closeAskMe );

	askMeBackdrop.addEventListener( "click", closeAskMe );


	// ============================================================
	// LET'S START
	// ============================================================

	btnLetsStart.addEventListener( "click", function ()
	{

		// Hide welcome screen
		askMeWelcome.classList.add( "hidden" );

		// Show chat screen
		askMeChat.classList.remove( "hidden" );
		askMeChat.classList.add( "flex" );

		// Focus question box
		document.getElementById( "aiQuestion" ).focus();

	} );
</script>