<script>

	function updateMyApprovalsCount ()
	{
		$.ajax( {
			url: "/TRRF/GetMyApprovalRequestList",
			type: "GET",

			success: function ( response )
			{
				const count = Array.isArray( response.data )
					? response.data.length
					: 0;

				const badge = $( "#myApprovalsCount" );
				const bell = $( "#myApprovalsBell" );

				if ( count > 0 )
				{
					badge.text( count );
					badge.removeClass( "hidden" );

					bell.addClass( "bell-ringing" );
				}
				else
				{
					badge.text( "" );
					badge.addClass( "hidden" );

					bell.removeClass( "bell-ringing" );
				}
			},

			error: function ()
			{
				$( "#myApprovalsCount" ).addClass( "hidden" );
				$( "#myApprovalsBell" ).removeClass( "bell-ringing" );
			}
		} );
	}

	$( document ).ready( function ()
	{
		updateMyApprovalsCount();
	} );

	$( "#myApprovalsNotification" ).on( "click", function ()
	{
		const checkbox = $( "#myApprovalsOnly" );

		checkbox.prop( "checked", !checkbox.prop( "checked" ) );
		checkbox.trigger( "change" );
	} );

	let dashboardLoaded = false;

	function openDashboardDrawer ()
	{
		$( "#dashboardOverlay" ).removeClass( "hidden" );

		$( "#dashboardDrawer" )
			.removeClass( "hidden" )
			.removeClass( "translate-y-full" );
		dashboardLoaded = false;

		if ( !dashboardLoaded )
		{
			loadDashboardSummary();
			loadMonthlyChart();
			loadStatusChart();
			loadCustomerChart();
			loadProductChart();
			loadRevisionChart();
			loadMoldChart();
			loadDeviationChart();
			loadTopRequestedProductsTable();
			loadMonthlyTrendTable();
			loadDetailedBreakdownTable();
			loadTRRFDistributionByLifeUtilization();

			dashboardLoaded = true;
		}
	}

	function closeDashboardDrawer ()
	{

		$( "#dashboardDrawer" )
			.addClass( "translate-y-full" );

		setTimeout( function ()
		{

			$( "#dashboardDrawer" ).addClass( "hidden" );
			$( "#dashboardOverlay" ).addClass( "hidden" );

		}, 300 );

	}

	// Open
	$( "#dashboardBtn" ).on( "click", openDashboardDrawer );

	// Close
	$( "#closeDashboardDrawer, #dashboardOverlay" ).on( "click", closeDashboardDrawer );


	const mpSwitch = document.getElementById( "mpSwitch" );
const pdSwitch = document.getElementById( "pdSwitch" );





const openDrawer = document.getElementById( "openSubmitDrawer" );
const closeDrawer = document.getElementById( "closeSubmitDrawer" );
const cancelDrawer = document.getElementById( "cancelSubmitDrawer" );
const drawer = document.getElementById( "submitDrawer" );
const overlay = document.getElementById( "submitDrawerOverlay" );
const customerSelect = document.getElementById( "customerIdTxt" );
const productIdInput = document.getElementById( "productIdTxt" );
const productNameInput = document.getElementById( "productNameTxt" );
const productOptions = document.getElementById( "productOptions" );

	const datePreparedInput = document.getElementById( "datePreparedTxt" );

	customerSelect.addEventListener("change", loadProductsByCustomer);

async function loadProductsByCustomer() {

    const customerId = customerSelect.value;

    productIdTxt.value = "";
    productNameInput.value = "";
    productOptions.innerHTML = "";
    productList = [];

    if (!customerId) {
        productNameInput.placeholder = "Add / Select product";
        return;
    }

    productNameInput.placeholder = "Loading products...";

    try {

        const response = await fetch(
            `@Url.Action("GetProductsByCustomer", "TRRF")?customerId=${customerId}`
        );

        if (!response.ok)
            throw new Error("Failed to load products.");

        productList = await response.json();

        productOptions.innerHTML = "";

        productList.forEach(product => {

            const option = document.createElement("option");

            option.value =
                product.productName +
                (product.modelpartno ? " - " + product.modelpartno : "");

            option.dataset.productId = product.productId;
            option.dataset.gml = product.gml;
            option.dataset.modelpartno = product.modelpartno ?? "";

            productOptions.appendChild(option);

        });

        productNameInput.placeholder = "Add / Select product";

    }
    catch (err) {

        console.error(err);
        productNameInput.placeholder = "Unable to load products";

    }

	}

	productNameInput.addEventListener( "input", function ()
	{

		const selected = productList.find( p =>
			( p.productName + ( p.modelpartno ? " - " + p.modelpartno : "" ) ) === this.value
		);

		if ( !selected )
		{

			productIdTxt.value = "";
			partModelNoTxt.value = "";   // or $("#partModelNoTxt").val("");

			return;
		}

		productIdTxt.value = selected.productId;

		// Populate Part / Model #
		partModelNoTxt.value = selected.modelpartno ?? "";

		// Optional if you need the GML later
		console.log( selected.gml );

	} );

mpSwitch.addEventListener( "change", function ()
{
	if ( mpSwitch.checked )
	{
		pdSwitch.checked = false;
	}
} );

pdSwitch.addEventListener( "change", function ()
{
	if ( pdSwitch.checked )
	{
		mpSwitch.checked = false;
	}
} );

function setDatePreparedToday ()
{
	const today = new Date().toISOString().split( "T" )[ 0 ];
	datePreparedInput.value = today;
}

openDrawer.addEventListener( "click", async function ()
{
	overlay.classList.remove( "hidden" );
	drawer.classList.remove( "translate-x-full" );

	setDatePreparedToday();

	await Promise.all( [
		loadCustomers(),
		//loadProducts(),
		loadControl()
	] );
} );

function closeSubmitDrawer ()
{
	drawer.classList.add( "translate-x-full" );
	overlay.classList.add( "hidden" );
}

function closeApprovalDrawer ()
{
	drawer.classList.add( "translate-x-full" );
	overlay.classList.add( "hidden" );
}

closeDrawer.addEventListener( "click", closeSubmitDrawer );
cancelDrawer.addEventListener( "click", closeSubmitDrawer );
overlay.addEventListener( "click", closeSubmitDrawer );


let productList = [];

async function loadProducts ()
{
	productNameInput.placeholder = "Loading products...";

	try
	{
		const response = await fetch( "@Url.Action("GetProductLookup", "TRRF")" );

		if ( !response.ok )
		{
			throw new Error( "Failed to load products" );
		}

		productList = await response.json();

		productOptions.innerHTML = "";

		productList.forEach( product =>
		{
			const option = document.createElement( "option" );
			option.value = product.productName;
			option.dataset.productId = product.productId;
			productOptions.appendChild( option );
		} );

		productNameInput.placeholder = "Add / Select product";
	} catch ( error )
	{
		console.error( error );
		productNameInput.placeholder = "Unable to load products";
	}
}

