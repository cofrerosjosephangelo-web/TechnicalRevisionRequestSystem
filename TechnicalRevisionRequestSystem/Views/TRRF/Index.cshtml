</div>



<script>
	window.mainTable = new Tabulator( "#main-table", {
		layout: "fitDataStretch",
		responsiveLayout: "collapse",
		height: "calc(100vh - 210px)",
		ajaxURL: "/TRRF/GetMainRows",

		columns: [
			{ title: "ID", field: "id", width: 80 },
			{ title: "Request Name", field: "name" },
			{ title: "Status", field: "status" },
		],

		rowFormatter: function ( row )
		{
			var data = row.getData();

			if ( !data.children || data.children.length === 0 ) return;

			var holder = document.createElement( "div" );
			holder.classList.add( "p-2" );
			holder.style.background = "rgba(255, 255, 255, 0.22)";
			holder.style.backdropFilter = "blur(10px)";
			holder.style.borderTop = "1px solid rgba(255, 255, 255, 0.35)";

			var childTable = document.createElement( "div" );
			holder.appendChild( childTable );

			row.getElement().appendChild( holder );

			new Tabulator( childTable, {
				layout: "fitColumns",
				data: data.children,
				columns: [
					{ title: "Task", field: "task" },
					{ title: "Assigned To", field: "assignedTo" },
					{ title: "Hours", field: "hours" },
				]
			} );
		}
	} );

	const openDrawer = document.getElementById( "openSubmitDrawer" );
	const closeDrawer = document.getElementById( "closeSubmitDrawer" );
	const drawer = document.getElementById( "submitDrawer" );
	const overlay = document.getElementById( "submitDrawerOverlay" );

	openDrawer.addEventListener( "click", function ()
	{
		overlay.classList.remove( "hidden" );
		drawer.classList.remove( "translate-x-full" );
	} );

	function closeSubmitDrawer ()
	{
		drawer.classList.add( "translate-x-full" );
		overlay.classList.add( "hidden" );
	}

	closeDrawer.addEventListener( "click", closeSubmitDrawer );
	overlay.addEventListener( "click", closeSubmitDrawer );
</script>