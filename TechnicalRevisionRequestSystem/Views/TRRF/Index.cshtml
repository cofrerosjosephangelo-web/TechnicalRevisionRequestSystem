<div class="glass-card tabulator-glass">

	<div class="flex items-center justify-between mb-4">

		<!-- Left -->
		<div class="flex items-center gap-4">
			<h2 class="text-lg font-semibold text-slate-700 flex items-center">
				<i class="fa fa-list-check mr-2"></i>
				TRRS Tracking
			</h2>

			<label class="inline-flex items-center cursor-pointer select-none">

				<!-- Switch -->
				<input type="checkbox"
					   id="myApprovalsOnly"
					   class="sr-only peer">

				<div class="relative w-11 h-6 rounded-full bg-slate-300 transition-all
                peer-checked:bg-blue-600
                after:absolute after:top-[2px] after:left-[2px]
                after:h-5 after:w-5 after:rounded-full
                after:bg-white after:transition-all
                after:content-['']
                peer-checked:after:translate-x-5">
				</div>

				<!-- Text + Notification -->
				<div class="relative ml-3 pr-5">

					<span class="text-sm text-slate-600 whitespace-nowrap">
						Show my approvals only
					</span>

					<!-- Notification Bell -->
					<button type="button"
							id="myApprovalsNotification"
							class="absolute -top-3 -right-1
                       flex items-center justify-center
                       w-6 h-6
                       rounded-full
                       hover:bg-yellow-50 transition">

						<i id="myApprovalsBell"
						   class="fa-solid fa-bell text-yellow-500 text-lg"></i>

						<!-- Count -->
						<span id="myApprovalsCount"
							  class="hidden absolute -top-2 -right-2
                         min-w-[17px] h-[17px] px-1
                         rounded-full bg-red-600 text-white
                         text-[9px] font-bold
                         flex items-center justify-center
                         border-2 border-white">
						</span>

					</button>

				</div>

			</label>
		</div>

		<!-- Right -->
		<div class="flex items-center">

			<button type="button"
					id="btnAskMe"
					class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-800 text-white text-sm font-medium hover:bg-slate-700 transition mr-2"
					title="Ask Me">
				<i class="fa-solid fa-robot me-1"></i>
				Ask Me
			</button>

			<!-- Dashboard -->
			<button type="button"
					id="dashboardBtn"
					class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-800 text-white text-sm font-medium hover:bg-slate-700 transition">
				<i class="fa-solid fa-chart-column"></i>
				<span>Dashboard</span>
			</button>

			<!-- Divider -->
			<div class="mx-3 h-7 w-px bg-slate-300"></div>

			<!-- Submit -->
			<button type="button"
					id="openSubmitDrawer"
					class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-800 text-white text-sm font-medium hover:bg-slate-700 transition">
				<i class="fa-solid fa-plus"></i>
				<span>Submit New</span>
			</button>

			<!-- Excel -->
			<button type="button"
					id="btnExportExcel"
					class="ml-2 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-700 text-white text-sm font-medium border border-white/40 hover:bg-black/70 transition">
				<i class="fa-solid fa-file-excel"></i>
				<span>Export Excel Report</span>
			</button>

		</div>

	</div>

	<div id="trrs-table" class="w-full"></div>

</div>


<div id="excelExportOverlay"
	 class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[99999] hidden flex items-center justify-center">

	<div class="text-center">

		<div class="w-36 h-36 mx-auto rounded-full bg-white shadow-2xl flex items-center justify-center">

			<i class="fa-solid fa-file-excel text-green-600 text-8xl animate-pulse"></i>

		</div>

		<h2 class="mt-8 text-3xl font-bold text-white tracking-wide">
			Exporting Excel Report
		</h2>

		<p class="mt-2 text-white/80 text-lg">
			Please wait while we generate your report...
		</p>

	</div>

</div>


