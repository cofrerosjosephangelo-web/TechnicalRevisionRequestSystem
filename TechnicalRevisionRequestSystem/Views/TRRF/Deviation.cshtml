<div class="glass-card p-6">

	<div class="flex items-center gap-2 pb-3 mb-4 border-b border-white/40">
		<i class="fa-solid fa-code-branch text-slate-600"></i>
		<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
			Deviation / Revision Information
		</h3>
	</div>

	<!-- With Deviation -->
	<div class="flex items-center justify-between">
		<label class="text-sm font-semibold text-slate-700">
			With Deviation / Revision
		</label>

		<label class="relative inline-flex items-center cursor-pointer">
			<input type="checkbox"
				   id="withDeviation"
				   class="sr-only peer">

			<div class="w-11 h-6 bg-slate-300 rounded-full
                        peer peer-checked:bg-blue-600
                        after:content-['']
                        after:absolute after:top-[2px] after:left-[2px]
                        after:bg-white after:border after:border-slate-300
                        after:rounded-full after:h-5 after:w-5
                        after:transition-all
                        peer-checked:after:translate-x-full">
			</div>
		</label>
	</div>

	<!-- Hidden until toggle is ON -->
	<div id="deviationFields" class="space-y-5 hidden mt-5">

		<!-- Deviation Date -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Deviation / Revision Date
			</label>

			<input type="date"
				   id="deviationDate"
				   value="@DateTime.Today.ToString("yyyy-MM-dd")"
				   class="w-full rounded-xl border border-slate-200 bg-white/70
                          px-4 py-2.5 text-slate-700
                          focus:outline-none focus:ring-2 focus:ring-blue-400">
		</div>




		<!-- Deviation Details -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Deviation / Revision Details
			</label>

			<textarea id="deviationDetails"
					  rows="6"
					  placeholder="Enter deviation details..."
					  class="w-full rounded-xl border border-slate-200 bg-white/70
                             px-4 py-3 text-slate-700 resize-none
                             focus:outline-none focus:ring-2 focus:ring-blue-400"></textarea>
		</div>


		<div class="space-y-6 glass-card">

			<!-- Root Cause -->
			<div class="rounded-xl border border-white/40 bg-white/25 p-4">

				<div class="flex items-center gap-2 pb-3 mb-4 border-b border-white/40">
					<i class="fa-solid fa-magnifying-glass-chart text-slate-600"></i>
					<h4 class="text-sm font-bold uppercase tracking-wide text-slate-700">
						Root Cause
					</h4>
				</div>

				<div id="rootCauseGroupUpdateRev" class="grid grid-cols-1 sm:grid-cols-2 gap-3">

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-gears text-slate-500 w-5"></i>
						<input type="checkbox" id="wearTearSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Wear &amp; Tear</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-screwdriver-wrench text-slate-500 w-5"></i>
						<input type="checkbox" id="machineErrorSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Machine Error</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-clock-rotate-left text-slate-500 w-5"></i>
						<input type="checkbox" id="prevImpvtSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Effect of Prev. Impvt</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-pen-ruler text-slate-500 w-5"></i>
						<input type="checkbox" id="designErrorSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Design Error</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-hammer text-slate-500 w-5"></i>
						<input type="checkbox" id="fabricationErrorSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Fabrication Error</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-user-check text-slate-500 w-5"></i>
						<input type="checkbox" id="customerReqSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Customer Req't</span>
					</label>

				</div>

				<div class="mt-4">
					<label class="block text-sm font-semibold text-slate-700 mb-2">
						Details
					</label>

					<textarea id="rootCauseDetailsTxtUpdateRev"
							  rows="5"
							  class="w-full resize-none rounded-lg border border-dark/40 bg-white/40 px-3 py-2 text-sm text-slate-700 outline-none placeholder:text-slate-400 "
							  placeholder="Root cause details"></textarea>
				</div>

				<div class="mt-4">
					<label class="block text-sm font-semibold text-slate-700 mb-2">
						<i class="fa-solid fa-paperclip mr-1"></i>
						Root Cause Attachment
					</label>

					<input type="file"
						   id="rootCauseAttachmentUpdateRev"
						   name="RootCauseAttachments"
						   accept=".doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.pdf"
						   multiple
						   class="block w-full text-sm text-slate-700 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-800 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-slate-700" />
				</div>

			</div>

			<!-- Proposed Action Plan -->
			<div class="rounded-xl border border-white/40 bg-white/25 p-4">

				<div class="flex items-center gap-2 pb-3 mb-4 border-b border-white/40">
					<i class="fa-solid fa-list-check text-slate-600"></i>
					<h4 class="text-sm font-bold uppercase tracking-wide text-slate-700">
						Proposed Action Plan
					</h4>
				</div>

				<div id="actionPlanGroupUpdateRev" class="grid grid-cols-1 sm:grid-cols-2 gap-3">

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-wrench text-slate-500 w-5"></i>
						<input type="checkbox" id="repairSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Repair</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-sliders text-slate-500 w-5"></i>
						<input type="checkbox" id="adjustmentSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Adjustment</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-pen-to-square text-slate-500 w-5"></i>
						<input type="checkbox" id="revisionSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Revision</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-repeat text-slate-500 w-5"></i>
						<input type="checkbox" id="replacementSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Replacement</span>
					</label>

					<label class="flex items-center gap-2 cursor-pointer select-none">
						<i class="fa-solid fa-flask-vial text-slate-500 w-5"></i>
						<input type="checkbox" id="trialTestingSwitchUpdateRev" class="peer sr-only" />
						<span class="relative w-10 h-5 rounded-full bg-slate-300 transition peer-checked:bg-slate-800 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
						<span class="text-sm font-medium text-slate-700">Trial / Testing</span>
					</label>

					<div class="hidden sm:block min-h-[60px]"></div>

				</div>

				<div class="mt-4">
					<label class="block text-sm font-semibold text-slate-700 mb-2">
						Details
					</label>

					<textarea id="actionPlanDetailsTxtUpdateRev"
							  rows="5"
							  class="w-full resize-none rounded-lg border border-dark/40 bg-white/40 px-3 py-2 text-sm text-slate-700 outline-none placeholder:text-slate-400"
							  placeholder="Proposed action plan details"></textarea>
				</div>

				<div class="mt-4">
					<label class="block text-sm font-semibold text-slate-700 mb-2">
						<i class="fa-solid fa-paperclip mr-1"></i>
						Action Plan Attachment
					</label>

					<input type="file"
						   id="actionPlanAttachmentUpdateRev"
						   name="ActionPlanAttachments"
						   accept=".doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.pdf"
						   multiple
						   class="block w-full text-sm text-slate-700 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-800 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-slate-700" />
				</div>

			</div>

		</div>

	</div>

</div>