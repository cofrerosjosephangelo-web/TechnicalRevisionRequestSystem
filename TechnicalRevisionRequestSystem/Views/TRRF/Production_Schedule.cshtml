<div class="glass-card p-6">

	<div class="flex items-center gap-2 pb-3 mb-4 border-b border-white/40">
		<i class="fa-solid fa-calendar-days text-slate-600"></i>
		<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
			Production Schedule
		</h3>
	</div>

	<div class="space-y-5">

		<!-- Date Received -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Date Received
			</label>

			<input type="date"
				   id="productionDateReceived"
				   value="@DateTime.Today.ToString("yyyy-MM-dd")"
				   class="w-full rounded-xl border border-slate-200 bg-white/70
                          px-4 py-2.5 text-slate-700
                          focus:outline-none focus:ring-2 focus:ring-blue-400">
		</div>

		<!-- Date Testing -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Date Testing
			</label>

			<input type="date"
				   id="productionDateTesting"
				   class="w-full rounded-xl border border-slate-200 bg-white/70
                          px-4 py-2.5 text-slate-700
                          focus:outline-none focus:ring-2 focus:ring-blue-400">
		</div>

	</div>

</div>