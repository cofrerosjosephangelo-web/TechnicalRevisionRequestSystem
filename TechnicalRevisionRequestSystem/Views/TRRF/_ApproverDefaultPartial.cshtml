@using Microsoft.AspNetCore.Http



<div class="glass-card p-6">

	<div class="space-y-5">

		<!-- Approval Date -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				<i class="fa fa-calendar me-1"></i>	Date of Approval
			</label>

			<input type="date"
				   id="approvalDate"
				   value="@DateTime.Today.ToString("yyyy-MM-dd")"
				   class="w-full rounded-xl border border-slate-200 bg-white/70
                          px-4 py-2.5 text-slate-700
                          focus:outline-none focus:ring-2 focus:ring-blue-400">
		</div>

		<!-- Approver -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				<i class="fa fa-user-check me-1"></i>	Name of Approver
			</label>

			<input type="text"
				   id="approverName"
				   readonly
				   value="@Model"
				   class="w-full rounded-xl border border-slate-200 bg-slate-100
                          px-4 py-2.5 text-slate-600 cursor-not-allowed">
		</div>

		<!-- Job ORder -->
		<div id="jobOrderPanel" class="hidden">
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				<i class="fa fa-box-open me-1"></i>	Job Order
			</label>

			<input type="text"
				   id="jobOrdertxt"
				   class="w-full rounded-xl border border-slate-200 bg-slate-50
                  px-4 py-2.5 text-slate-600">
		</div>

		<!-- Remarks -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				<i class="fa fa-edit me-1"></i>	Approval Remarks
			</label>

			<textarea id="approvalRemarks"
					  rows="5"
					  placeholder="Enter approval remarks..."
					  class="w-full rounded-xl border border-slate-200 bg-white/70
                             px-4 py-3 text-slate-700 resize-none
                             focus:outline-none focus:ring-2 focus:ring-blue-400"></textarea>
		</div>

		<!-- Attachment -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Attachment
			</label>

			<input type="file"
				   id="approvalAttachment"
				   name="ApproverAttachments"
				   multiple
				   accept=".doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.pdf"
				   class="block w-full text-sm text-slate-700 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-800 file:px-3 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-slate-700 cursor-pointer">
		</div>

	</div>

	<!-- Footer Buttons -->


</div>