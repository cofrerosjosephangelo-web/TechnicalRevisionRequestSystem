<!-- DASHBOARD OVERLAY -->
<div id="dashboardOverlay"
	 class="fixed inset-0
            bg-black/30
            backdrop-blur-sm
            hidden
            z-[80]">
</div>

<!-- DASHBOARD DRAWER -->
<div id="dashboardDrawer"
	 class="fixed inset-0
            bg-white/70
            backdrop-blur-xl
            hidden
            z-[90]
            translate-y-full
            transition-transform duration-300
            flex flex-col">

	<!-- ===================================================== -->
	<!-- HEADER -->
	<!-- ===================================================== -->

	<div class="h-20
                px-6
                border-b border-white/40
                bg-white/50
                backdrop-blur-md
                flex items-center justify-between
                flex-shrink-0">

		<!-- Left -->
		<div class="flex items-center gap-4">

			<div class="w-12 h-12
                        rounded-2xl
                        bg-gradient-to-br
                        from-sky-500
                        to-indigo-600
                        text-white
                        flex items-center justify-center
                        shadow-lg">

				<i class="fa-solid fa-chart-column text-lg"></i>

			</div>

			<div>

				<h2 class="text-xl font-bold tracking-wide text-slate-700">
					TECHNICAL REVISION REQUEST SYSTEM DASHBOARD
				</h2>

				<p class="text-xs text-slate-500">
					Business Intelligence & Analytics
				</p>

			</div>

		</div>

		<!-- Right -->
		<div class="flex items-end gap-4">

			<!-- Year -->
			<div>
				<label class="block mb-1 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
					Year
				</label>

				<select id="dashboardYear"
						class="w-28
                               rounded-xl
                               border border-slate-300
                               bg-white/70
                               backdrop-blur
                               px-3 py-2
                               text-sm
                               shadow-sm
                               focus:outline-none
                               focus:ring-2
                               focus:ring-sky-500">
				</select>
			</div>

			<!-- Month -->
			<div>
				<label class="block mb-1 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
					Month
				</label>

				<select id="dashboardMonth"
						class="w-44
                               rounded-xl
                               border border-slate-300
                               bg-white/70
                               backdrop-blur
                               px-3 py-2
                               text-sm
                               shadow-sm
                               focus:outline-none
                               focus:ring-2
                               focus:ring-sky-500">

					<option value="0">All Months</option>
					<option value="1">January</option>
					<option value="2">February</option>
					<option value="3">March</option>
					<option value="4">April</option>
					<option value="5">May</option>
					<option value="6">June</option>
					<option value="7">July</option>
					<option value="8">August</option>
					<option value="9">September</option>
					<option value="10">October</option>
					<option value="11">November</option>
					<option value="12">December</option>

				</select>
			</div>

			<!-- Refresh -->
			<button id="refreshDashboardBtn"
					class="h-[42px]
                           px-5
                           rounded-xl
                           bg-sky-600
                           text-white
                           text-sm
                           font-medium
                           hover:bg-sky-700
                           transition">

				<i class="fa-solid fa-rotate-right me-2"></i>
				Refresh

			</button>

			<!-- Close -->
			<button id="closeDashboardDrawer"
					class="w-11 h-11
                           rounded-xl
                           hover:bg-white/60
                           transition">

				<i class="fa-solid fa-xmark text-lg"></i>

			</button>

		</div>

	</div>

	<!-- ===================================================== -->
	<!-- DASHBOARD BODY -->
	<!-- ===================================================== -->

	<div id="dashboardBody"
		 class="flex-1 overflow-y-auto p-6">

		<!-- KPI Cards -->
		<div id="dashboardKPIs"
			 class="grid
            grid-cols-1
            sm:grid-cols-2
            lg:grid-cols-3
            2xl:grid-cols-4
            gap-5
            mb-6">

			<!-- Total Requests -->
			<div class="glass-card rounded-2xl p-5 border border-white/40 shadow-lg">

				<div class="flex items-start justify-between">

					<div>

						<p class="text-[11px] uppercase tracking-[0.2em] text-slate-500 font-semibold">
							Total Requests
						</p>

						<h2 id="kpiTotalRequests"
							class="mt-3 text-4xl font-black text-slate-800">
							0
						</h2>

					</div>

					<div class="w-14 h-14 rounded-2xl bg-sky-100 flex items-center justify-center">

						<i class="fa-solid fa-file-lines text-sky-600 text-2xl"></i>

					</div>

				</div>

			</div>

			<!-- PD Requests -->
			<div class="glass-card rounded-2xl p-5 border border-white/40 shadow-lg">

				<div class="flex items-start justify-between">

					<div>

						<p class="text-[11px] uppercase tracking-[0.2em] text-slate-500 font-semibold">
							PD Requests
						</p>

						<h2 id="kpiPD"
							class="mt-3 text-4xl font-black text-blue-700">
							0
						</h2>

					</div>

					<div class="w-14 h-14 rounded-2xl bg-blue-100 flex items-center justify-center">

						<i class="fa-solid fa-gears text-blue-700 text-2xl"></i>

					</div>

				</div>

			</div>

			<!-- MP Requests -->
			<div class="glass-card rounded-2xl p-5 border border-white/40 shadow-lg">

				<div class="flex items-start justify-between">

					<div>

						<p class="text-[11px] uppercase tracking-[0.2em] text-slate-500 font-semibold">
							MP Requests
						</p>

						<h2 id="kpiMP"
							class="mt-3 text-4xl font-black text-emerald-700">
							0
						</h2>

					</div>

					<div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center">

						<i class="fa-solid fa-industry text-emerald-700 text-2xl"></i>

					</div>

				</div>

			</div>

			<!-- Customers -->
			<div class="glass-card rounded-2xl p-5 border border-white/40 shadow-lg">

				<div class="flex items-start justify-between">

					<div>

						<p class="text-[11px] uppercase tracking-[0.2em] text-slate-500 font-semibold">
							Customers
						</p>

						<h2 id="kpiCustomers"
							class="mt-3 text-4xl font-black text-purple-700">
							0
						</h2>

					</div>

					<div class="w-14 h-14 rounded-2xl bg-purple-100 flex items-center justify-center">

						<i class="fa-solid fa-users text-purple-700 text-2xl"></i>

					</div>

				</div>

			</div>

			<!-- Products -->
			<div class="glass-card rounded-2xl p-5 border border-white/40 shadow-lg">

				<div class="flex items-start justify-between">

					<div>

						<p class="text-[11px] uppercase tracking-[0.2em] text-slate-500 font-semibold">
							Products
						</p>

						<h2 id="kpiProducts"
							class="mt-3 text-4xl font-black text-amber-700">
							0
						</h2>

					</div>

					<div class="w-14 h-14 rounded-2xl bg-amber-100 flex items-center justify-center">

						<i class="fa-solid fa-box-open text-amber-700 text-2xl"></i>

					</div>

				</div>

			</div>

			<!-- Molds -->
			<div class="glass-card rounded-2xl p-5 border border-white/40 shadow-lg">

				<div class="flex items-start justify-between">

					<div>

						<p class="text-[11px] uppercase tracking-[0.2em] text-slate-500 font-semibold">
							Molds
						</p>

						<h2 id="kpiMolds"
							class="mt-3 text-4xl font-black text-rose-700">
							0
						</h2>

					</div>

					<div class="w-14 h-14 rounded-2xl bg-rose-100 flex items-center justify-center">

						<i class="fa-solid fa-cubes text-rose-700 text-2xl"></i>

					</div>

				</div>

			</div>

			<!-- Average Revision -->
			<div class="glass-card rounded-2xl p-5 border border-white/40 shadow-lg">

				<div class="flex items-start justify-between">

					<div>

						<p class="text-[11px] uppercase tracking-[0.2em] text-slate-500 font-semibold">
							Average Revision
						</p>

						<h2 id="kpiRevision"
							class="mt-3 text-4xl font-black text-red-600">
							0.00
						</h2>

					</div>

					<div class="w-14 h-14 rounded-2xl bg-red-100 flex items-center justify-center">

						<i class="fa-solid fa-code-branch text-red-600 text-2xl"></i>

					</div>

				</div>

			</div>

		</div>

		<!-- Charts -->

		<div class="grid grid-cols-12 gap-6">

			<div class="col-span-12">

				<div class="glass-card
                rounded-2xl
                border border-white/40
                shadow-lg
                overflow-hidden">

					<!-- Header -->
					<div class="px-6 py-4
                    border-b border-slate-200/40
                    flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								TRRF Distribution by Mold Life Utilization
							</h3>

							<p class="text-xs text-slate-500">
								Pareto analysis of Technical Revision Requests across mold life utilization stages
							</p>

						</div>

						<div class="w-12 h-12
                        rounded-xl
                        bg-orange-100
                        flex items-center justify-center">

							<i class="fa-solid fa-chart-line text-orange-600 text-xl"></i>

						</div>

					</div>

					<!-- Chart -->

					<div class="p-5">

						<div id="moldLifeUtilizationChart"
							 class="w-full h-[420px]">
						</div>

					</div>

				</div>

			</div>

			<div class="col-span-12">

				<div class="glass-card
rounded-2xl
border border-white/40
shadow-lg
overflow-hidden">

					<!-- Header -->
					<div class="px-6 py-4
    border-b border-slate-200/40
    flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								Top Requested Products
							</h3>

							<p class="text-xs text-slate-500">
								Ranked list of products with the highest number of TRRF requests
							</p>

						</div>

						<div class="w-12 h-12
        rounded-xl
        bg-sky-100
        flex items-center justify-center">

							<i class="fa-solid fa-table-list text-sky-600 text-xl"></i>

						</div>

					</div>

					<!-- Table -->

					<div id="topRequestedProductsTable"></div>

				</div>

			</div>

			<div class="col-span-12 xl:col-span-6">

				<div class="glass-card rounded-2xl border border-white/40 shadow-lg overflow-hidden">

					<div class="px-6 py-4 border-b border-slate-200/40 flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								Monthly Trend of TRRF Requests
							</h3>

							<p class="text-xs text-slate-500">
								Monthly summary of MP and PD requests
							</p>

						</div>

						<div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center">
							<i class="fa-solid fa-chart-column text-indigo-600 text-xl"></i>
						</div>

					</div>

					<div id="monthlyTrendTable"></div>

				</div>

			</div>

			<div class="col-span-12 xl:col-span-6">

				<div class="glass-card rounded-2xl border border-white/40 shadow-lg overflow-hidden">

					<div class="px-6 py-4 border-b border-slate-200/40 flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								Detailed Breakdown
							</h3>

							<p class="text-xs text-slate-500">
								Monthly breakdown of closed, pending and total TRRF requests
							</p>

						</div>

						<div class="w-12 h-12 rounded-xl bg-emerald-100 flex items-center justify-center">
							<i class="fa-solid fa-table text-emerald-600 text-xl"></i>
						</div>

					</div>

					<div id="detailedBreakdownTable"></div>

				</div>

			</div>

			<div class="col-span-8">
				<div class="glass-card p-5 h-[420px]">
					<div id="monthlyChart" class="w-full h-full"></div>
				</div>
			</div>

			<div class="col-span-4">
				<div class="glass-card p-5 h-[420px]">
					<div id="statusChart" class="w-full h-full"></div>
				</div>
			</div>

			<div class="col-span-12 xl:col-span-6">

				<div class="glass-card
                rounded-2xl
                border border-white/40
                shadow-lg
                overflow-hidden">

					<!-- Header -->
					<div class="px-6 py-4
                    border-b border-slate-200/40
                    flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								Requests by Customer
							</h3>

							<p class="text-xs text-slate-500">
								Total Technical Revision Requests per customer
							</p>

						</div>

						<div class="w-12 h-12
                        rounded-xl
                        bg-indigo-100
                        flex items-center justify-center">

							<i class="fa-solid fa-building text-indigo-600 text-xl"></i>

						</div>

					</div>

					<!-- Chart -->
					<div class="p-5">

						<div id="customerChart"
							 class="w-full h-[320px]">
						</div>

					</div>

				</div>

			</div>

			<div class="col-span-12 xl:col-span-6">

				<div class="glass-card
                rounded-2xl
                border border-white/40
                shadow-lg
                overflow-hidden">

					<div class="px-6 py-4
                    border-b border-slate-200/40
                    flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								Requests by Product
							</h3>

							<p class="text-xs text-slate-500">
								Total Technical Revision Requests per product
							</p>

						</div>

						<div class="w-12 h-12
                        rounded-xl
                        bg-amber-100
                        flex items-center justify-center">

							<i class="fa-solid fa-box-open text-amber-600 text-xl"></i>

						</div>

					</div>

					<div class="p-5">

						<div id="productChart"
							 class="w-full h-[320px]">
						</div>

					</div>

				</div>

			</div>

			<div class="col-span-12 xl:col-span-6">

				<div class="glass-card
                rounded-2xl
                border border-white/40
                shadow-lg
                overflow-hidden">

					<div class="px-6 py-4
                    border-b border-slate-200/40
                    flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								Revision Distribution
							</h3>

							<p class="text-xs text-slate-500">
								Number of requests by revision version
							</p>

						</div>

						<div class="w-12 h-12
                        rounded-xl
                        bg-red-100
                        flex items-center justify-center">

							<i class="fa-solid fa-code-branch text-red-600 text-xl"></i>

						</div>

					</div>

					<div class="p-5">

						<div id="revisionChart"
							 class="w-full h-[320px]"></div>

					</div>

				</div>

			</div>

			<div class="col-span-12 xl:col-span-6">

				<div class="glass-card
                rounded-2xl
                border border-white/40
                shadow-lg
                overflow-hidden">

					<div class="px-6 py-4
                    border-b border-slate-200/40
                    flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								Requests by Mold
							</h3>

							<p class="text-xs text-slate-500">
								Total Technical Revision Requests grouped by mold number
							</p>

						</div>

						<div class="w-12 h-12
                        rounded-xl
                        bg-violet-100
                        flex items-center justify-center">

							<i class="fa-solid fa-cubes text-violet-600 text-xl"></i>

						</div>

					</div>

					<div class="p-5">

						<div id="moldChart"
							 class="w-full h-[320px]"></div>

					</div>

				</div>

			</div>

			<div class="col-span-12 xl:col-span-6">

				<div class="glass-card
                rounded-2xl
                border border-white/40
                shadow-lg
                overflow-hidden">

					<div class="px-6 py-4
                    border-b border-slate-200/40
                    flex items-center justify-between">

						<div>

							<h3 class="text-lg font-bold text-slate-700">
								Deviation/Revision Analytics
							</h3>

							<p class="text-xs text-slate-500">
								Original requests versus deviation requests
							</p>

						</div>

						<div class="w-12 h-12
                        rounded-xl
                        bg-emerald-100
                        flex items-center justify-center">

							<i class="fa-solid fa-code-compare text-emerald-600 text-xl"></i>

						</div>

					</div>

					<div class="p-5">

						<div id="deviationChart"
							 class="w-full h-[320px]"></div>

					</div>

				</div>

			</div>



		</div>

	</div>

</div>

@await Html.PartialAsync("_LifeUtilizationStageDrawer")