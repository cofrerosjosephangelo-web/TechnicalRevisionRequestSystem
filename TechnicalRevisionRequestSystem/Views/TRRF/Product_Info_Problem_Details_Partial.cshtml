<div class="glass-card p-4">

	<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">

		<!-- Control No -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				TRRF Control No.
			</label>

			<input type="text"
				   id="viewControlNo" 
				   readonly
				   class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />
		</div>

		<!-- TRRF No -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				TRRF No.
			</label>

			<input type="text"
				   id="viewTrrfNo" 
				   readonly
				   class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />
		</div>

		<!-- Date Prepared -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Date Prepared
			</label>

			<input type="text"
				   id="viewDatePrepared" 
				   readonly
				   class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />
		</div>

		<!-- Type -->
		<div>
			<label class="block text-sm font-semibold text-slate-700 mb-2">
				Request Type
			</label>

			<input type="text"
				   id="viewTrrsType" 
				   readonly
				   class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />
		</div>

	</div>

</div>

<!-- PRODUCT INFORMATION -->
<div class="glass-card p-5">

	<div class="flex items-center gap-2 pb-3 mb-4 border-b border-white/40">
		<i class="fa-solid fa-box-open text-slate-600"></i>
		<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
			Product Information
		</h3>
	</div>

	<div class="grid grid-cols-2 gap-4">

		<div>
			<div class="text-xs text-slate-500 uppercase mb-1">
				Customer Name
			</div>
			
			<input id="viewCustomerName" readonly class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />
		</div>

		<div>
			<div class="text-xs text-slate-500 uppercase mb-1">
				Product Name
			</div>
			<input id="viewProductName" readonly class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />
		</div>

		<div>
			<div class="text-xs text-slate-500 uppercase mb-1">
				Mold No.
			</div>
			<input id="viewMoldNo" readonly class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />
		</div>

		<div>
			<div class="text-xs text-slate-500 uppercase mb-1">
				Part / Model No.
			</div>
			<input id="viewPartModelNo" readonly class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />
		</div>

	</div>

</div>

<!-- PROBLEM DETAILS -->
<div class="glass-card p-5">

	<div class="flex items-center gap-2 pb-3 mb-4 border-b border-white/40">
		<i class="fa-solid fa-triangle-exclamation text-slate-600"></i>
		<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
			Problem Details
		</h3>
	</div>

	<div class="grid lg:grid-cols-2 gap-4">

		<div>
			<div class="text-xs text-slate-500 uppercase mb-2">
				Encountered Problem
			</div>

			<textarea id="viewEncounteredProblem" readonly class="w-full rounded-lg border border-dark/40 bg-white/30 p-3 min-h-[120px] whitespace-pre-wrap"></textarea>

			
		</div>

		<div>
			<div class="text-xs text-slate-500 uppercase mb-2">
				Machine Name
			</div>

			<textarea id="viewMachineName" readonly class="w-full rounded-lg border border-dark/40 bg-white/30 p-3 min-h-[120px] whitespace-pre-wrap"></textarea>


			<div class="mt-3">
				<span class="text-xs text-slate-500 uppercase">
					Mold Tool Life
				</span>

				<input id="viewMoldToolLife" readonly class="w-full px-3 py-2 rounded-lg border border-dark/40 bg-white/40 text-sm text-slate-700" />

				
			</div>
		</div>

	</div>

</div>

<!-- ROOT CAUSE + ACTION PLAN -->
<div class="grid lg:grid-cols-2 gap-4">

	<!-- ROOT CAUSE -->
	<div class="glass-card p-5">

		<div class="flex items-center justify-between mb-4">

			<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
				Root Cause
			</h3>

			<button id="btnViewRootCauseAttachment"
					type="button"
					class="hidden px-3 py-1.5 text-xs font-medium rounded-lg
                           bg-blue-500/10 text-blue-700 border border-blue-300/50
                           hover:bg-blue-500/20 transition">
				<i class="fa fa-paperclip me-1"></i>&nbsp;View Attachment(s)
			</button>

		</div>

		<div id="viewRootCauseList"
			 class="grid grid-cols-1 gap-2 text-sm text-slate-700">
		</div>

		<div class="mt-4">
			<div class="text-xs text-slate-500 uppercase mb-2">
				Details
			</div>

			<div id="viewRootCauseDetails"
				 class="rounded-lg border border-dark/40 bg-white/30 p-3 min-h-[120px] whitespace-pre-wrap">
			</div>
		</div>

	</div>

	<!-- ACTION PLAN -->
	<div class="glass-card p-5">

		<div class="flex items-center justify-between mb-4">

			<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
				Proposed Action Plan
			</h3>

			<button id="btnViewActionPlanAttachment"
					type="button"
					class="hidden px-3 py-1.5 text-xs font-medium rounded-lg
                           bg-blue-500/10 text-blue-700 border border-blue-300/50
                           hover:bg-blue-500/20 transition">
				<i class="fa fa-paperclip me-1"></i>&nbsp;View Attachment(s)
			</button>

		</div>

		<div id="viewActionPlanList"
			 class="grid grid-cols-1 gap-2 text-sm text-slate-700">
		</div>

		<div class="mt-4">
			<div class="text-xs text-slate-500 uppercase mb-2">
				Details
			</div>

			<div id="viewActionPlanDetails"
				 class="rounded-lg border border-dark/40 bg-white/30 p-3 min-h-[120px] whitespace-pre-wrap">
			</div>
		</div>

	</div>

</div>

<!-- CONTAINMENT -->
<div class="glass-card p-5">

	<div class="flex items-center gap-2 pb-3 mb-4 border-b border-white/40">
		<i class="fa-solid fa-boxes-stacked text-slate-600"></i>
		<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
			Containment
		</h3>
	</div>

	<div class="grid grid-cols-2 gap-4">

		<div>
			<div class="text-xs text-slate-500 uppercase mb-1">
				Has Spare
			</div>

			<div id="viewHasSpare"
				 class="font-medium text-slate-700">
			</div>
		</div>

		<div>
			<div class="text-xs text-slate-500 uppercase mb-1">
				Quantity
			</div>

			<div id="viewQuantity"
				 class="font-medium text-slate-700">
			</div>
		</div>

	</div>

</div>

<div class="glass-card p-5">

	<div class="flex items-center justify-between pb-3 mb-4 border-b border-white/40">

		<div class="flex items-center gap-2">
			<i class="fa-solid fa-people-group text-slate-600"></i>

			<h3 class="text-sm font-bold uppercase tracking-wide text-slate-700">
				Minutes of the Meeting
			</h3>
		</div>

		<button id="btnViewMomAttachment"
				type="button"
				class="hidden px-3 py-1.5 text-xs font-medium rounded-lg
					   bg-blue-500/10 text-blue-700 border border-blue-300/50
					   hover:bg-blue-500/20 transition">
			<i class="fa fa-paperclip me-1"></i>&nbsp;View Attachment(s)
		</button>

	</div>

	<div>

		<div class="text-xs text-slate-500 uppercase mb-2">
			Remarks
		</div>

		<div id="viewMomRemarks"
			 class="rounded-lg border border-dark/40 bg-white/30 p-3 min-h-[140px] whitespace-pre-wrap text-slate-700">
		</div>

	</div>

</div>