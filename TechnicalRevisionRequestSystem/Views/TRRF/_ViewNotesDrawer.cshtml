<!-- ==========================================
	 VIEW NOTES DRAWER
========================================== -->
<div id="viewNotesDrawer"
	 class="fixed top-0 right-0 z-[60]
            h-full w-[450px]
            bg-white shadow-2xl
            transform translate-x-full
            transition-transform duration-300 ease-in-out">

	<!-- Header -->
	<div class="flex items-center justify-between
                px-5 py-4
                border-b border-slate-200">

		<div>
			<h2 class="text-lg font-semibold text-slate-800">
				<i class="fa-solid fa-eye me-2 text-slate-500"></i>
				View Notes
			</h2>

			<p class="text-xs text-slate-400 mt-1">
				Approval Notes
			</p>
		</div>

		<button type="button"
				id="closeViewNotesDrawer"
				class="w-9 h-9 rounded-lg
                       text-slate-500
                       hover:bg-slate-100
                       hover:text-slate-700
                       transition">

			<i class="fa-solid fa-xmark text-lg"></i>
		</button>

	</div>


	<!-- Body -->
	<div class="p-5">

		<label class="block text-sm font-medium text-slate-700 mb-2">
			Notes
		</label>

		<textarea id="viewApprovalNotes"
				  rows="16"
				  readonly
				  class="w-full resize-none
                         rounded-lg
                         border border-slate-300
                         bg-slate-50
                         px-3 py-3
                         text-sm text-slate-700
                         focus:outline-none"></textarea>

		<!-- Character Count -->
		<div class="flex justify-end mt-1">
			<span id="viewNotesCharacterCount"
				  class="text-xs text-slate-400">
				0 / 2000
			</span>
		</div>

	</div>

</div>


<!-- View Notes Overlay -->
<div id="viewNotesOverlay"
	 class="fixed inset-0 z-[55]
            hidden bg-black/30">
</div>